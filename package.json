{
  "name": "dsh-approval-sentinel",
  "version": "0.1.0",
  "description": "帮我批准 for DeepSeek Harness: when a permission approval goes unanswered, a fresh risk-assessment agent reviews the request — auto-approving low-risk operations, rejecting dangerous ones, and keeping the dialog waiting for the human when uncertain.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/dsh-settings": "*",
    "@deepseek-ai/dsh-llm": "*"
  },
  "scripts": {
    "test": "node tests/notifier.test.mjs && node tests/waterfall.test.mjs && node tests/integration.mjs && node tests/client-card.test.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "approval",
    "帮我批准",
    "risk-assessment",
    "auto-approve",
    "permission",
    "subagent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dongfang81/dsh-approval-sentinel.git"
  }
}
